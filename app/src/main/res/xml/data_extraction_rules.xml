<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Back up only user preferences; exclude any transient/private device state. -->
    <cloud-backup>
        <include domain="sharedpref" path="."/>
        <exclude domain="sharedpref" path="device.xml"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="."/>
        <exclude domain="sharedpref" path="device.xml"/>
    </device-transfer>
</data-extraction-rules>
