<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget info for the 2×2 birthday countdown widget.
  updatePeriodMillis = 3600000 → update every hour.
  Note: Android throttles widget updates to at most every 30 minutes on some OEM ROMs.
-->
<appwidget-provider
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:maxResizeWidth="450dp"
    android:maxResizeHeight="220dp"
    android:updatePeriodMillis="3600000"
    android:initialLayout="@layout/widget_layout"
    android:previewImage="@drawable/widget_preview_birthday"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description" />
