# Release signing scaffold (example)
#
# 1. Generate a keystore:
#    keytool -genkey -v -keystore release.jks -alias age_reveal \
#      -keyalg RSA -keysize 2048 -validity 10000
# 2. Copy this file to `keystore.properties` at the project root (git-ignored).
# 3. Fill in the fields below — never commit the real file.
# 4. Run `./gradlew bundleRelease` to produce a signed AAB for Play Store upload.

storeFile=../release.jks
storePassword=CHANGE_ME
keyAlias=age_reveal
keyPassword=CHANGE_ME
